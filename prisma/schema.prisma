generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackSource {
  EBAY
  POKEMON_CENTER
}

model Set {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  era         String
  releaseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packs       Pack[]
  cards       Card[]

  @@index([releaseDate])
  @@map("sets")
}

model Pack {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  summary        String
  imageUrl       String?
  releaseDate    DateTime
  setId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  set            Set      @relation(fields: [setId], references: [id], onDelete: Restrict)
  cards          PackCard[]
  prices         PackPrice[]
  sourceListings SourceListing[]
  pullRates      PullRate[]

  @@index([releaseDate])
  @@index([setId])
  @@map("packs")
}

model Card {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  cardNumber     String
  rarity         String
  subset         String?
  specialTag     String?
  imageUrl       String?
  setId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  set            Set      @relation(fields: [setId], references: [id], onDelete: Restrict)
  prices         CardPrice[]
  pullRates      PullRate[]
  packs          PackCard[]

  @@index([setId])
  @@map("cards")
}

model PackCard {
  id        String   @id @default(cuid())
  packId    String
  cardId    String
  createdAt DateTime @default(now())

  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Restrict)
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([packId, cardId])
  @@index([packId])
  @@index([cardId])
  @@map("pack_cards")
}

model CardPrice {
  id         String   @id @default(cuid())
  cardId     String
  sourceName String
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("USD")
  fetchedAt  DateTime @default(now())

  card       Card     @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([cardId, fetchedAt])
  @@map("card_prices")
}

model PackPrice {
  id        String     @id @default(cuid())
  packId    String
  source    PackSource
  price     Decimal    @db.Decimal(10, 2)
  currency  String     @default("USD")
  fetchedAt DateTime   @default(now())

  pack      Pack       @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([packId, source, fetchedAt])
  @@map("pack_prices")
}

model PullRate {
  id          String   @id @default(cuid())
  packId       String
  cardId       String
  probability  Decimal @db.Decimal(8, 6)
  isEstimated  Boolean @default(false)
  sourceName   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pack         Pack    @relation(fields: [packId], references: [id], onDelete: Restrict)
  card         Card    @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([packId, cardId])
  @@index([packId])
  @@index([cardId])
  @@map("pull_rates")
}

model SourceListing {
  id              String     @id @default(cuid())
  packId           String
  source           PackSource
  externalId       String
  title            String
  listingUrl       String
  price            Decimal    @db.Decimal(10, 2)
  currency         String     @default("USD")
  isInStock        Boolean    @default(true)
  confidenceScore  Decimal    @db.Decimal(4, 2)
  rawPayload       Json
  fetchedAt        DateTime   @default(now())
  createdAt        DateTime   @default(now())

  pack             Pack       @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@unique([source, externalId])
  @@index([packId, source])
  @@map("source_listings")
}
