generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id          String       @id @default(cuid())
  name        String       @unique
  marketplace String
  createdAt   DateTime     @default(now())
  listings    RawListing[]
  sales       NormalizedSale[]
}

model RawListing {
  id                String   @id @default(cuid())
  sourceId          String
  externalListingId String
  title             String
  payload           Json
  ingestedAt        DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, externalListingId])
  @@index([ingestedAt])
}

model NormalizedSale {
  id                String    @id @default(cuid())
  sourceId          String
  externalListingId String
  saleDate          DateTime
  title             String
  price             Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD")
  quantity          Int       @default(1)
  condition         String?

  cardId    String?
  setId     String?
  pokemonId String?

  ingestedAt DateTime @default(now())

  source  Source   @relation(fields: [sourceId], references: [id])
  card    Card?    @relation(fields: [cardId], references: [id])
  set     Set?     @relation(fields: [setId], references: [id])
  pokemon Pokemon? @relation(fields: [pokemonId], references: [id])

  @@unique([sourceId, externalListingId])
  @@index([saleDate])
  @@index([setId])
  @@index([pokemonId])
  @@index([price])
}

model Card {
  id            String           @id @default(cuid())
  name          String
  cardNumber    String?
  setId         String
  pokemonId     String?
  normalizedSales NormalizedSale[]

  set     Set      @relation(fields: [setId], references: [id])
  pokemon Pokemon? @relation(fields: [pokemonId], references: [id])

  @@unique([name, cardNumber, setId])
}

model Set {
  id              String           @id @default(cuid())
  name            String           @unique
  seriesId        String?
  normalizedSales NormalizedSale[]
  cards           Card[]

  series Series? @relation(fields: [seriesId], references: [id])
}

model Pokemon {
  id              String           @id @default(cuid())
  name            String           @unique
  normalizedSales NormalizedSale[]
  cards           Card[]
}

model Series {
  id   String @id @default(cuid())
  name String @unique
  sets Set[]
}
